{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "buildCommand": "npm run build",
      "installCommand": "npm install"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/main.ts",
      "buildCommand": "npm run build",
      "installCommand": "npm install"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "type": "service",
        "service": "backend",
        "path": "/api/v1/{1}"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}

# ==============================================================================
# ALMS Frontend Environment Variables (.env.local)
# ==============================================================================

# Backend API endpoint (used for Next.js internal rewrites & direct API calls)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# AI Service direct endpoint (optional for client-side direct tests)
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# Supabase Public API Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
